node_modules/
lib/
# scripts/lib is source (the shared catalog-entry emitter), not a build output
!scripts/lib/
!scripts/lib/**
lib-client/
lib-host/
dist/
dist-plugins/
*.tsbuildinfo
tsconfig.tsbuildinfo
.env
# electron-builder outputs (pack layouts keep the version in the dir name)
apps/desktop/release*/
.snap-rail/
.zcode/*
external/

# tsc emissions strayed into vendored sources (main points at lib/)
vendor/*/src/*.js
vendor/*/src/*.js.map
vendor/*/src/*.d.ts
vendor/*/src/*.d.ts.map
# same for package sources — a mis-rooted tsc run must never pollute the tree
packages/*/src/*.js
packages/*/src/*.js.map
packages/*/src/*.d.ts
packages/*/src/*.d.ts.map
packages/*/*/src/*.js
packages/*/*/src/*.js.map
packages/*/*/src/*.d.ts
packages/*/*/src/*.d.ts.map
dist-publish/
collect-out/
collect-dl/
dl/
deploy.config.json
.keys/
.pnpm-store/
website/public/site-assets/
website/public/plugin-development.md
