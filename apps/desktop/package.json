{
  "name": "@snap-rail/desktop",
  "description": "The snap-rail desktop shell: frameless Electron window over the host plugin tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build:faces:host": "tsc -b && tsdown --config tsdown.config.ts",
    "build:faces": "pnpm run build:faces:host && vite build",
    "pack": "pnpm run build:faces && electron-builder --win --dir --config electron-builder.yml",
    "dist": "pnpm run build:faces && electron-builder --win nsis --config electron-builder.yml"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@snap-rail/app-boot": "workspace:^",
    "@snap-rail/audit": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/cordis-plugin-timer": "workspace:^",
    "@snap-rail/driver-mock": "workspace:^",
    "@snap-rail/driver-modbus": "workspace:^",
    "@snap-rail/field": "workspace:^",
    "@snap-rail/gateway": "workspace:^",
    "@snap-rail/settings": "workspace:^",
    "@snap-rail/station-rpc": "workspace:^",
    "@snap-rail/store": "workspace:^",
    "@snap-rail/suite-terminal-ops": "workspace:^",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@snap-rail/client-fallback": "workspace:^",
    "@snap-rail/client-kernel": "workspace:^",
    "@snap-rail/client-modules": "workspace:^",
    "@snap-rail/client-runtime": "workspace:^",
    "@snap-rail/client-settings": "workspace:^",
    "@snap-rail/client-variables": "workspace:^",
    "@snap-rail/client-slots": "workspace:^",
    "@snap-rail/connection": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/settings-station": "workspace:^",
    "@snap-rail/suite-terminal-ops": "workspace:^",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
