{
  "name": "@snap-rail/desktop",
  "description": "The snap-rail desktop shell: frameless Electron window over the host plugin tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "license": "Apache-2.0",
  "scripts": {
