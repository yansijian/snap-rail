{
  // Resolution facade for workspace imports. NEVER add include/files to this
  // file: it would leak into every extending package project and narrow the
  // facade's match-all scope.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    // Source-level resolution for every repo-local graph. Project references,
    // not declaration path aliases, keep each package/vendor source compiled
    // under its own tsconfig boundary.
    "paths": {
      "@snap-rail/cordis": ["./vendor/cordis/src"],
      "@snap-rail/cosmokit": ["./vendor/cosmokit/src"],
      "@snap-rail/schemastery": ["./vendor/schemastery/src"],
      "@snap-rail/cordis-plugin-loader": ["./vendor/loader/src"],
      "@snap-rail/cordis-plugin-include": ["./vendor/include/src"],
      "@snap-rail/cordis-plugin-group": ["./vendor/group/src"],
      "@snap-rail/cordis-plugin-timer": ["./vendor/timer/src"],
      "@snap-rail/cordis-plugin-hmr": ["./vendor/hmr/src"],
      "@snap-rail/cordis-plugin-logger-console": ["./vendor/logger-console/src"],
      "@snap-rail/util": ["./packages/util/util/src"],
      "@snap-rail/plugin-kit": ["./packages/util/plugin-kit/src"],
      "@snap-rail/plugin-kit/manifest": ["./packages/util/plugin-kit/src/manifest.ts"],
      "@snap-rail/plugin-kit/seeds": ["./packages/util/plugin-kit/src/seeds.ts"],
      "@snap-rail/plugin-kit/build": ["./packages/util/plugin-kit/src/build.ts"],
      "@snap-rail/settings": ["./packages/settings/settings/src"],
      "@snap-rail/store": ["./packages/store/store/src"],
      "@snap-rail/audit": ["./packages/audit/audit/src"],
      "@snap-rail/app-boot": ["./packages/boot/app-boot/src"],
      "@snap-rail/app-boot/rpc": ["./packages/boot/app-boot/src/rpc.ts"],
      "@snap-rail/app-boot/contract": ["./packages/boot/app-boot/src/contract.ts"],
      "@snap-rail/app-boot/scan": ["./packages/boot/app-boot/src/scan.ts"],
      "@snap-rail/protocol": ["./packages/protocol/protocol/src"],
      "@snap-rail/gateway": ["./packages/protocol/gateway/src"],
      "@snap-rail/connection": ["./packages/protocol/connection/src"],
      "@snap-rail/field": ["./packages/field/field/src"],
      "@snap-rail/field/rpc": ["./packages/field/field/src/rpc.ts"],
      "@snap-rail/field/station": ["./packages/field/field/src/station.tsx"],
      "@snap-rail/driver-mock": ["./packages/field/driver-mock/src"],
      "@snap-rail/driver-modbus": ["./packages/field/driver-modbus/src"],
      "@snap-rail/client-ui": ["./packages/client/ui/src"],
      "@snap-rail/client-ui/theme.css": ["./packages/client/ui/src/theme.css"],
      "@snap-rail/client-kernel": ["./packages/client/kernel/src"],
      "@snap-rail/client-slots": ["./packages/client/slots/src"],
      "@snap-rail/client-settings": ["./packages/client/settings/src"],
      "@snap-rail/client-variables": ["./packages/client/variables/src"],
      "@snap-rail/settings-station": ["./packages/client/settings-station/src"],
      "@snap-rail/client-session": ["./packages/client/session/src"],
      "@snap-rail/client-workflows": ["./packages/client/workflows/src"],
      "@snap-rail/client-runtime": ["./packages/client/runtime/src"],
      "@snap-rail/client-modules": ["./packages/client/modules/src"],
      "@snap-rail/client-fallback": ["./packages/client/fallback/src"],
      "@snap-rail/suite-terminal-ops": ["./packages/suites/terminal-ops/src"],
      "@snap-rail/suite-terminal-ops/stats": ["./packages/suites/terminal-ops/src/stats.ts"],
      "@snap-rail/station-rpc": ["./packages/boot/station-rpc/src"],
      "@snap-rail/station-rpc/contract": ["./packages/boot/station-rpc/src/contract.ts"]
    }
  }
}
