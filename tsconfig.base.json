{
  // Resolution facade for workspace imports. NEVER add include/files to this
  // file: it would leak into every extending package project and narrow the
  // facade's match-all scope.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    // Source-level resolution for every repo-local graph. Project references,
    // not declaration path aliases, keep each package/vendor source compiled
    // under its own tsconfig boundary.
    "paths": {
      "@snap-rail/cordis": ["./vendor/cordis/src"],
      "@snap-rail/cosmokit": ["./vendor/cosmokit/src"],
      "@snap-rail/schemastery": ["./vendor/schemastery/src"],
      "@snap-rail/cordis-plugin-loader": ["./vendor/loader/src"],
      "@snap-rail/cordis-plugin-include": ["./vendor/include/src"],
      "@snap-rail/cordis-plugin-group": ["./vendor/group/src"],
      "@snap-rail/cordis-plugin-timer": ["./vendor/timer/src"],
      "@snap-rail/cordis-plugin-hmr": ["./vendor/hmr/src"],
      "@snap-rail/cordis-plugin-logger-console": ["./vendor/logger-console/src"],
      "@snap-rail/scope": ["./packages/base/scope/src"],
      "@snap-rail/util": ["./packages/base/util/src"],
      "@snap-rail/util/manifest": ["./packages/base/util/src/manifest.ts"],
      "@snap-rail/plugin-kit": ["./packages/base/plugin-kit/src"],
      "@snap-rail/plugin-kit/manifest": ["./packages/base/plugin-kit/src/manifest.ts"],
      "@snap-rail/plugin-kit/seeds": ["./packages/base/plugin-kit/src/seeds.ts"],
      "@snap-rail/plugin-kit/build": ["./packages/base/plugin-kit/src/build.ts"],
      "@snap-rail/plugin-kit/pack": ["./packages/base/plugin-kit/src/pack.ts"],
      "@snap-rail/plugin-kit/sign": ["./packages/base/plugin-kit/src/sign.ts"],
      "@snap-rail/plugin-kit/recipe": ["./packages/base/plugin-kit/src/recipe.ts"],
      "@snap-rail/plugin-sdk": ["./packages/base/plugin-sdk/src"],
      "@snap-rail/settings": ["./packages/base/settings/src"],
      "@snap-rail/store": ["./packages/store/store/src"],
      "@snap-rail/store-sqlite": ["./packages/store/store-sqlite/src"],
      "@snap-rail/audit": ["./packages/base/audit/src"],
      "@snap-rail/app-boot": ["./packages/base/app-boot/src"],
      "@snap-rail/app-boot/rpc": ["./packages/base/app-boot/src/rpc.ts"],
      "@snap-rail/app-boot/contract": ["./packages/base/app-boot/src/contract.ts"],
      "@snap-rail/app-boot/scan": ["./packages/base/app-boot/src/scan.ts"],
      "@snap-rail/app-boot/trust": ["./packages/base/app-boot/src/trust.ts"],
      "@snap-rail/protocol": ["./packages/base/protocol/src"],
      "@snap-rail/shell": ["./packages/base/shell/src"],
      "@snap-rail/shell/contract": ["./packages/base/shell/src/contract.ts"],
      "@snap-rail/gateway": ["./packages/base/gateway/src"],
      "@snap-rail/connection": ["./packages/base/connection/src"],
      "@snap-rail/equipment": ["./packages/equipment/equipment/src"],
      "@snap-rail/equipment/rpc": ["./packages/equipment/equipment/src/rpc.ts"],
      "@snap-rail/equipment/contract": ["./packages/equipment/equipment/src/contract.ts"],
      "@snap-rail/equipment/driver": ["./packages/equipment/equipment/src/driver.ts"],
      "@snap-rail/equipment-station": ["./packages/ui/equipment-station/src/index.tsx"],
      "@snap-rail/client-kernel": ["./packages/base/kernel/src"],
      "@snap-rail/client-modules": ["./packages/base/modules/src"],
      "@snap-rail/station-rpc": ["./packages/base/station-rpc/src"],
      "@snap-rail/station-rpc/contract": ["./packages/base/station-rpc/src/contract.ts"]
    }
  }
}
