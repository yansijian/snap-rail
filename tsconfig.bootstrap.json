{
  // Bootstrap build for the split plugin repos: their TypeScript programs
  // resolve the base packages through workspace declarations, so those
  // declarations (and the JS the paired tsdown.bootstrap.config bundles) must
  // exist before `external/` is built. The graph covers everything under the
  // UI substrate (shell + ui included — the paired bootstrap tsdown's
  // `packages/base/*` glob picks up both, so both must emit); it stops before
  // equipment-station, whose page library builds in the full host project.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": false
  },
  "files": [],
  "references": [
    { "path": "./vendor/cosmokit" },
    { "path": "./vendor/schemastery" },
    { "path": "./vendor/cordis" },
    { "path": "./vendor/loader" },
    { "path": "./vendor/include" },
    { "path": "./vendor/group" },
    { "path": "./vendor/timer" },
    { "path": "./vendor/hmr" },
    { "path": "./vendor/logger-console" },
    { "path": "./packages/base/util" },
    { "path": "./packages/base/scope" },
    { "path": "./packages/base/plugin-kit" },
    { "path": "./packages/base/plugin-sdk" },
    { "path": "./packages/base/settings" },
    { "path": "./packages/store/store" },
    { "path": "./packages/store/store-sqlite" },
    { "path": "./packages/base/audit" },
    { "path": "./packages/base/app-boot" },
    { "path": "./packages/base/station-rpc" },
    { "path": "./packages/base/protocol" },
    { "path": "./packages/base/shell" },
    { "path": "./packages/base/ui" },
    { "path": "./packages/base/gateway" },
    { "path": "./packages/base/connection" },
    { "path": "./packages/equipment/equipment" },
    { "path": "./packages/base/kernel" },
    { "path": "./packages/base/modules" }
  ]
}
