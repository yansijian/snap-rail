{
  "name": "@snap-rail/app-boot",
  "description": "Host boot glue: plugin pool scan, two-layer composition, boot tree, layer admin; ./contract is the plugins-domain wire contract",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./rpc": {
      "types": "./lib/types/rpc.d.ts",
      "default": "./lib/rpc.js"
    },
    "./contract": {
      "types": "./lib/types/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./scan": {
      "types": "./lib/types/scan.d.ts",
      "default": "./lib/scan.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/rpc.js",
    "lib/contract.js",
    "lib/scan.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "fflate": "^0.8.3",
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@snap-rail/audit": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/cordis-plugin-group": "workspace:^",
    "@snap-rail/cordis-plugin-include": "workspace:^",
    "@snap-rail/cordis-plugin-loader": "workspace:^",
    "@snap-rail/gateway": "workspace:^",
    "@snap-rail/protocol": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@snap-rail/audit": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/cordis-plugin-group": "workspace:^",
    "@snap-rail/cordis-plugin-include": "workspace:^",
    "@snap-rail/cordis-plugin-loader": "workspace:^",
    "@snap-rail/gateway": "workspace:^",
    "@snap-rail/protocol": "workspace:^",
    "zod": "^4.4.3"
  }
}
