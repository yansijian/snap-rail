{
  "name": "@snap-rail/store-sqlite",
  "description": "The persistence seam's reference implementation: one node:sqlite database per namespace under the snap-rail home (single-active store backend)",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "peerDependencies": {
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/store": "workspace:^"
  },
  "devDependencies": {
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/store": "workspace:^",
    "@types/node": "^22.20.0"
  },
  "snapRail": {
    "layer": "store",
    "exclusive": "store-backend",
    "category": "存储",
    "title": "本地存储（SQLite）"
  }
}
