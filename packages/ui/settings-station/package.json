{
  "name": "@snap-rail/settings-station",
  "description": "The settings dialog shell: renders the settingsPages registry (menu + content) and the first-party plugin management page",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@snap-rail/connection": "workspace:^",
    "@snap-rail/station-rpc": "workspace:^",
    "@snap-rail/framework-shadcn": "workspace:^"
  },
  "peerDependencies": {
    "@snap-rail/cordis": "workspace:^",
    "react": ">=19"
  },
  "devDependencies": {
    "@snap-rail/app-boot": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@types/react": "^19.2.14",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "zod": "^4.4.3",
    "@snap-rail/plugin-kit": "workspace:^"
  },
  "snapRail": {
    "layer": "ui",
    "category": "界面",
    "capabilities": {
      "requires": [
        { "id": "ui.renderer.react", "range": "^1.0.0" },
        { "id": "ui.contract", "range": "^1.0.0" }
      ]
    },
    "framework": "@snap-rail/framework-shadcn",
    "clientOnly": true,
    "requires": [
      "@snap-rail/framework-shadcn"
    ],
    "client": {
      "entry": "lib-client/client.js"
    },
    "title": "设置中心"
  }
}
