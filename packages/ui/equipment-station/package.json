{
  "name": "@snap-rail/equipment-station",
  "description": "The built-in 设备管理 settings page: devices, groups, points and driver dialect forms over the semantic UI kit",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/page.js",
  "types": "lib/types/page.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/page.d.ts",
      "default": "./lib/page.js"
    },
    "./page": {
      "types": "./lib/types/page.d.ts",
      "default": "./lib/page.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/page.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@snap-rail/connection": "workspace:^",
    "@snap-rail/equipment": "workspace:^",
    "@snap-rail/ui": "workspace:^",
    "react": ">=19"
  },
  "devDependencies": {
    "@snap-rail/connection": "workspace:^",
    "@snap-rail/equipment": "workspace:^",
    "@snap-rail/ui": "workspace:*",
    "@types/react": "^19.2.14",
    "happy-dom": "^20.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "snapRail": {
    "layer": "ui",
    "title": "设备管理"
  }
}