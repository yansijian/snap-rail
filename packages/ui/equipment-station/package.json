{
  "name": "@snap-rail/equipment-station",
  "description": "The unified 设备管理 settings page: devices, groups, and points of the equipment base, edited through the driver dialect forms",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@snap-rail/connection": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/equipment": "workspace:^",
    "@snap-rail/framework-shadcn": "^0.1.3",
    "react": ">=19"
  },
  "devDependencies": {
    "@snap-rail/connection": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/driver-modbus": "^0.1.0",
    "@snap-rail/equipment": "workspace:^",
    "@snap-rail/framework-shadcn": "^0.1.3",
    "@snap-rail/gateway": "workspace:^",
    "@snap-rail/protocol": "workspace:^",
    "@snap-rail/audit": "workspace:^",
    "@snap-rail/store-sqlite": "workspace:^",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "happy-dom": "^18.0.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "zod": "^4.4.3",
    "@snap-rail/plugin-kit": "workspace:^"
  },
  "snapRail": {
    "layer": "ui",
    "category": "界面",
    "capabilities": {
      "requires": [
        { "id": "ui.renderer.react", "range": "^1.0.0" },
        { "id": "ui.contract", "range": "^1.0.0" },
        { "id": "equipment.runtime", "range": "^1.0.0" }
      ]
    },
    "framework": "@snap-rail/framework-shadcn",
    "clientOnly": true,
    "requires": [
      "@snap-rail/framework-shadcn",
      "@snap-rail/equipment"
    ],
    "client": {
      "entry": "lib-client/client.js"
    },
    "title": "设备管理"
  }
}
