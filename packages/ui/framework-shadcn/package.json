{
  "name": "@snap-rail/framework-shadcn",
  "description": "The UI framework (single-active): slot vocabulary, renderer runtime + shell, shadcn-style shared primitives, theme tokens, settings/session/variables/workflows services, and the fallback layout",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runtime": {
      "types": "./lib/types/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./slots": {
      "types": "./lib/types/slots.d.ts",
      "default": "./lib/slots.js"
    },
    "./ui": {
      "types": "./lib/types/ui/index.d.ts",
      "default": "./lib/ui/index.js"
    },
    "./settings-pages": {
      "types": "./lib/types/settings-pages.d.ts",
      "default": "./lib/settings-pages.js"
    },
    "./session": {
      "types": "./lib/types/session.d.ts",
      "default": "./lib/session.js"
    },
    "./variables": {
      "types": "./lib/types/variables.d.ts",
      "default": "./lib/variables.js"
    },
    "./workflows": {
      "types": "./lib/types/workflows.d.ts",
      "default": "./lib/workflows.js"
    },
    "./fallback": {
      "types": "./lib/types/fallback.d.ts",
      "default": "./lib/fallback.js"
    },
    "./theme.css": "./src/ui/theme.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src/ui/theme.css"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.8",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@snap-rail/client-kernel": "workspace:^",
    "@snap-rail/connection": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/cordis-plugin-timer": "workspace:^",
    "@snap-rail/equipment": "workspace:^",
    "@snap-rail/protocol": "workspace:^",
    "@snap-rail/station-rpc": "workspace:^",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@snap-rail/client-kernel": "workspace:^",
    "@snap-rail/connection": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/cordis-plugin-timer": "workspace:^",
    "@snap-rail/equipment": "workspace:^",
    "@snap-rail/plugin-kit": "workspace:^",
    "@snap-rail/protocol": "workspace:^",
    "@snap-rail/station-rpc": "workspace:^",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "snapRail": {
    "kind": "framework",
    "layer": "ui",
    "exclusive": "framework",
    "category": "界面",
    "clientOnly": true,
    "client": {
      "entry": "lib-client/client.js",
      "seeds": [
        "ui",
        "slots",
        "settings-pages",
        "session",
        "variables",
        "workflows",
        "runtime",
        "fallback"
      ]
    },
    "title": "界面框架"
  }
}
