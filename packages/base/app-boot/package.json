{
  "name": "@snap-rail/app-boot",
  "description": "Host boot glue: plugin pool scan, two-layer composition, boot tree, layer admin, offline combo install; ./contract is the plugins+update wire contract; ./invariant the layer-check sidecar",
  "version": "0.1.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./rpc": {
      "types": "./lib/types/rpc.d.ts",
      "default": "./lib/rpc.js"
    },
    "./contract": {
      "types": "./lib/types/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./scan": {
      "types": "./lib/types/scan.d.ts",
      "default": "./lib/scan.js"
    },
    "./seed-abi": {
      "types": "./lib/types/seed-abi.d.ts",
      "default": "./lib/seed-abi.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./trust": {
      "types": "./lib/types/trust.d.ts",
      "default": "./lib/trust.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/rpc.js",
    "lib/contract.js",
    "lib/scan.js",
    "lib/invariant.js",
    "lib/trust.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@snap-rail/plugin-kit": "workspace:^",
    "@snap-rail/util": "workspace:^",
    "fflate": "^0.8.3",
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "@snap-rail/audit": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/cordis-plugin-group": "workspace:^",
    "@snap-rail/cordis-plugin-include": "workspace:^",
    "@snap-rail/cordis-plugin-loader": "workspace:^",
    "@snap-rail/gateway": "workspace:^",
    "@snap-rail/protocol": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@snap-rail/audit": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/cordis-plugin-group": "workspace:^",
    "@snap-rail/cordis-plugin-include": "workspace:^",
    "@snap-rail/cordis-plugin-loader": "workspace:^",
    "@snap-rail/gateway": "workspace:^",
    "@snap-rail/plugin-kit": "workspace:^",
    "@snap-rail/protocol": "workspace:^",
    "zod": "^4.4.3"
  },
  "snapRail": {
    "layer": "base",
    "title": "插件管理"
  }
}

