{
  "name": "@snap-rail/util",
  "description": "Zero-dependency utilities shared across snap-rail packages",
  "version": "0.1.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./manifest": {
      "types": "./lib/types/manifest.d.ts",
      "default": "./lib/manifest.js"
    },
    "./semver": {
      "types": "./lib/types/semver.d.ts",
      "default": "./lib/semver.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "snapRail": {
    "layer": "base"
  }
}
