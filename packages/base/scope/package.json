{
  "name": "@snap-rail/scope",
  "description": "Scoped-context registration primitive (scope tags, scope-filtered event dispatch, scoped registry layers); ported from the deepseek-harness dsh-scope package",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@snap-rail/cordis": "workspace:^"
  },
  "devDependencies": {
    "@snap-rail/cordis": "workspace:^"
  },
  "snapRail": {
    "layer": "base"
  }
}
