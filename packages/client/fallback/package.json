{
  "name": "@snap-rail/client-fallback",
  "description": "The fallback shell: the built-in minimal layout for zero-suite installs (bare titlebar + install guidance); yields the moment a suite layout registers",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@snap-rail/client-settings": "workspace:^",
    "@snap-rail/client-slots": "workspace:^",
    "@snap-rail/client-ui": "workspace:^",
    "@snap-rail/connection": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "react": ">=19"
  },
  "devDependencies": {
    "@snap-rail/client-settings": "workspace:^",
    "@snap-rail/client-slots": "workspace:^",
    "@snap-rail/client-ui": "workspace:^",
    "@snap-rail/connection": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@types/react": "^19.2.14",
    "react": "^19.2.8"
  }
}
