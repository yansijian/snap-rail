{
  "name": "@snap-rail/modbus-station",
  "description": "The ModbusTCP settings page: device CRUD, variable mappings over the registry, manual debug variables, live values",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
