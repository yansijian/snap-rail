{
  "name": "@snap-rail/client-runtime",
  "description": "Client renderer host: plugin-tree mounting, slot-driven shell, theme tokens",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
