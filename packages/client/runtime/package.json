  "peerDependencies": {
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/connection": "workspace:^",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/connection": "workspace:^",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
