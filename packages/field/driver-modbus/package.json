{
  "name": "@snap-rail/driver-modbus",
  "description": "The ModbusTCP field driver: a pure protocol adapter over the field base (block polling, decode/encode, probe); devices, groups, and points live in the base's configuration tables",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contract": {
      "types": "./lib/types/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/contract.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "snapRail": {
    "kind": "driver"
  },
  "dependencies": {
    "modbus-serial": "8.0.23-no-serial-port",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/cordis-plugin-timer": "workspace:^",
    "@snap-rail/field": "workspace:^"
  },
  "devDependencies": {
    "@snap-rail/audit": "workspace:^",
    "@snap-rail/client-settings": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/cordis-plugin-timer": "workspace:^",
    "@snap-rail/field": "workspace:^",
    "@snap-rail/gateway": "workspace:^",
    "@snap-rail/store": "workspace:^",
    "@testing-library/react": "^16.3.3",
    "happy-dom": "^18.0.0",
    "rolldown": "^1.2.5"
  }
}
