{
  "name": "@snap-rail/suite-terminal-ops",
  "description": "The terminal-ops business suite: the whole renderer face of one industrial scenario (station layout + chrome + five process pages + counting settings) plus its host-side shift counter (./stats); one package, one toggle, snapRail.kind = suite",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "snapRail": {
    "kind": "suite",
    "layer": "suite",
    "exclusive": "suite",
    "category": "界面",
    "framework": "@snap-rail/framework-shadcn",
    "capabilities": {
      "requires": [
        { "id": "ui.renderer.react", "range": "^1.0.0" },
        { "id": "ui.contract", "range": "^1.0.0" },
        { "id": "equipment.runtime", "range": "^1.0.0" }
      ]
    },
    "clientOnly": true,
    "requires": [
      "@snap-rail/framework-shadcn",
      "@snap-rail/trend",
      "@snap-rail/equipment"
    ],
    "client": {
      "entry": "lib-client/client.js"
    },
    "title": "生产作业套件"
  },
  "dependencies": {
    "@snap-rail/util": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3",
    "@snap-rail/trend": "workspace:^"
  },
  "peerDependencies": {
    "@snap-rail/connection": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/cordis-plugin-timer": "workspace:^",
    "@snap-rail/equipment": "workspace:^",
    "@snap-rail/gateway": "workspace:^",
    "@snap-rail/protocol": "workspace:^",
    "@snap-rail/settings": "workspace:^",
    "@snap-rail/station-rpc": "workspace:^",
    "@snap-rail/store": "workspace:^",
    "react": ">=19",
    "@snap-rail/framework-shadcn": "workspace:^"
  },
  "devDependencies": {
    "@snap-rail/connection": "workspace:^",
    "@snap-rail/cordis": "workspace:^",
    "@snap-rail/cordis-plugin-timer": "workspace:^",
    "@snap-rail/equipment": "workspace:^",
    "@snap-rail/gateway": "workspace:^",
    "@snap-rail/plugin-kit": "workspace:^",
    "@snap-rail/protocol": "workspace:^",
    "@snap-rail/settings": "workspace:^",
    "@snap-rail/station-rpc": "workspace:^",
    "@snap-rail/store": "workspace:^",
    "@types/react": "^19.2.14",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "@snap-rail/framework-shadcn": "workspace:^",
    "@snap-rail/trend": "workspace:^"
  }
}
