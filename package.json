{
  "name": "@snap-rail/root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.host.json && tsdown",
    "build:lib:host": "tsc -b tsconfig.host.json && tsdown",
    "typecheck": "tsc -b tsconfig.host.json",
    "test": "pnpm run build && vitest run && pnpm run verify:spine",
    "verify-vendor-names": "tsx scripts/verify-vendor-names.ts",
    "app:dev": "pnpm --filter @snap-rail/desktop run dev",
    "app:start": "pnpm --filter @snap-rail/desktop run start",
    "verify:spine": "tsx scripts/verify-spine.ts",
    "pack:plugins": "tsx scripts/pack-plugins.ts",
    "app:pack": "pnpm --filter @snap-rail/desktop run pack",
    "app:dist": "pnpm --filter @snap-rail/desktop run dist",
    "website:dev": "pnpm --filter @snap-rail/website run dev",
    "website:build": "pnpm --filter @snap-rail/website run build"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "fflate": "^0.8.3",
    "happy-dom": "^20.0.11",
    "js-yaml": "^4.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.8"
  }
}
