{
  "name": "@snap-rail/root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.host.json && tsdown",
    "build:lib:host": "tsc -b tsconfig.host.json && tsdown",
    "typecheck": "tsc -b tsconfig.host.json",
    "test": "pnpm run build && vitest run && pnpm run verify:layers && pnpm run verify:wire-catalog",
    "verify-vendor-names": "tsx scripts/verify-vendor-names.ts",
    "app:dev": "pnpm --filter @snap-rail/desktop run dev",
    "app:start": "pnpm --filter @snap-rail/desktop run start",
    "verify:layers": "tsx scripts/verify-layers.ts",
    "setup:external": "node scripts/setup-external.mjs",
    "verify:packaged-app": "tsx scripts/verify-packaged-app.ts",
    "pack:plugins": "tsx scripts/pack-plugins.ts",
    "verify:feed": "tsx scripts/verify-plugin-feed.ts",
    "collect:feed": "tsx scripts/collect-feed.ts",
    "plugin:generate-key": "tsx scripts/generate-release-key.ts",
    "publish": "tsx scripts/publish.ts",
    "publish:local": "tsx scripts/publish.ts --skip-sync",
    "app:pack": "pnpm --filter @snap-rail/desktop run pack && pnpm run verify:packaged-app",
    "app:dist": "pnpm --filter @snap-rail/desktop run dist && pnpm run verify:packaged-app",
    "website:dev": "pnpm --filter @snap-rail/website run dev",
    "website:build": "tsx scripts/gen-website-catalog.ts && tsx scripts/copy-site-assets.ts && pnpm --filter @snap-rail/website run build",
    "site:build": "tsx scripts/gen-website-catalog.ts && tsx scripts/copy-site-assets.ts && pnpm --filter @snap-rail/website run build",
    "gen:wire-catalog": "tsx scripts/gen-wire-catalog.ts",
    "verify:wire-catalog": "tsx scripts/gen-wire-catalog.ts --check"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "fflate": "^0.8.3",
    "happy-dom": "^20.0.11",
    "js-yaml": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
